---
// Intermittent shooting stars for the hero — pure CSS, no JS.
//
// The construction mirrors meganyap.me's .shooting-star, read from its live
// CSS: the streak is monospace TEXT — a dashed trail with a dot head — not a
// drawn gradient line.
//   markup      "──────·" in --font-mono at 13px, letter-spacing 0.12em
//   colour      85% star colour, text-shadow 0 0 12px @50% (the halo)
//   easing      cubic-bezier(.16,.84,.44,1) — fast launch, decelerating glide
//   fade        in by 8% of the streak, out after 90%
//   geometry    ~570px/s average, 154deg down-left path, ~1.8s streaks,
//               one star every ~5.8s
// After rotate(154deg) the string's end maps furthest down-left, so the "·"
// (last character) leads and the dashes trail behind it.
//
// Their site spawns each streak from JS with a one-shot animation and a
// randomised timer. CSS can't randomise, so cadence comes from geometry
// instead: five stars on ~30s cycles with delays a fifth of a cycle apart put
// exactly one star on screen every ~5.8s. Cycle lengths are staggered 28-32s
// so the spacing drifts instead of ticking like a metronome. The streak
// occupies the first 6% of each cycle (~1.8s) and the star sits invisible for
// the rest. Their in-streak fade points (8% / 90%) map to 0.5% / 5.4% here.
//
// Colour comes from --color-star, the same token the Starfield dots use, so a
// streak always reads as one of the dots breaking loose.
const stars = [
  { top: "4%", left: "88%", travel: "958px", dur: "28s", delay: "0s" },
  { top: "15%", left: "100%", travel: "992px", dur: "29s", delay: "5.8s" },
  { top: "27%", left: "92%", travel: "1026px", dur: "30s", delay: "11.6s" },
  { top: "8%", left: "76%", travel: "1060px", dur: "31s", delay: "17.4s" },
  { top: "20%", left: "96%", travel: "1094px", dur: "32s", delay: "23.2s" },
];
---

<div class="shooting-stars" aria-hidden="true">
  {
    stars.map((star) => (
      <span
        class="star"
        style={`--top:${star.top};--left:${star.left};--travel:${star.travel};--duration:${star.dur};--delay:${star.delay};`}
      >
        ──────·
      </span>
    ))
  }
</div>

<style>
  .shooting-stars {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .star {
    position: absolute;
    top: var(--top);
    left: var(--left);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    line-height: 1;
    white-space: nowrap;
    user-select: none;
    color: color-mix(in oklab, var(--color-star) 85%, transparent);
    text-shadow: 0 0 12px
      color-mix(in oklab, var(--color-star) 50%, transparent);
    transform-origin: 0 center;
    opacity: 0;
    will-change: transform, opacity;
    animation: shoot var(--duration) cubic-bezier(0.16, 0.84, 0.44, 1)
      var(--delay) infinite;
  }

  /* 0-6%: the streak (~1.8s of a ~30s cycle). 6-100%: parked and invisible,
     which is what spaces the stars ~6s apart without a scheduler.
     0.899/0.438 are cos/sin 154deg — the components of --travel. */
  @keyframes shoot {
    0% {
      transform: translate3d(0, 0, 0) rotate(154deg);
      opacity: 0;
    }
    0.5% {
      opacity: 1;
    }
    5.4% {
      opacity: 1;
    }
    6%,
    100% {
      transform: translate3d(
          calc(var(--travel) * -0.899),
          calc(var(--travel) * 0.438),
          0
        )
        rotate(154deg);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shooting-stars {
      display: none;
    }
  }
</style>
