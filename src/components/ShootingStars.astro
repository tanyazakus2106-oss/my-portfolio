---
// Intermittent shooting stars for the hero — pure CSS, no JS.
//
// The construction mirrors meganyap.me's .shooting-star, read from its live
// CSS: the streak is monospace TEXT — a dashed trail with a dot head — not a
// drawn gradient line.
//   markup      "──────·" in --font-mono at 13px, letter-spacing 0.12em
//   colour      85% star colour, text-shadow 0 0 12px @50% (the halo)
//   easing      linear — deliberate deviation: the reference's
//               cubic-bezier(.16,.84,.44,1) glide left the star visibly
//               stalled at the end of its path; owner asked for constant speed
//   fade        in by 8% of the streak, out over the last fifth — the star
//               fades while still moving, so it never appears to stop
//   geometry    ~570px/s average, 154deg down-left path, ~1.74s streaks
// After rotate(154deg) the string's end maps furthest down-left, so the "·"
// (last character) leads and the dashes trail behind it.
//
// Their site spawns each streak from JS with a one-shot animation and a
// randomised timer. CSS can't randomise, so cadence comes from geometry
// instead: five stars share one 29s cycle with uneven delays, so the gaps
// read irregular (4-8s) while the pattern repeats. Equal durations keep the
// phases locked, and every gap is wider than a streak lasts (~1.74s), which
// guarantees at most one star on screen — the earlier 28-32s stagger let
// phases drift until two streaks overlapped. The streak occupies the first
// 6% of each cycle and the star sits invisible for the rest.
//
// Colour comes from --color-star, the same token the Starfield dots use, so a
// streak always reads as one of the dots breaking loose.
const stars = [
  { top: "4%", left: "88%", travel: "958px", dur: "29s", delay: "0s" },
  { top: "15%", left: "100%", travel: "992px", dur: "29s", delay: "4.2s" },
  { top: "27%", left: "92%", travel: "1026px", dur: "29s", delay: "11.3s" },
  { top: "8%", left: "76%", travel: "1060px", dur: "29s", delay: "16.1s" },
  { top: "20%", left: "96%", travel: "1094px", dur: "29s", delay: "23.9s" },
];
---

<div class="shooting-stars" aria-hidden="true">
  {
    stars.map((star) => (
      <span
        class="star"
        style={`--top:${star.top};--left:${star.left};--travel:${star.travel};--duration:${star.dur};--delay:${star.delay};`}
      >
        ──────·
      </span>
    ))
  }
</div>

<style>
  .shooting-stars {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .star {
    position: absolute;
    top: var(--top);
    left: var(--left);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    line-height: 1;
    white-space: nowrap;
    user-select: none;
    color: color-mix(in oklab, var(--color-star) 85%, transparent);
    text-shadow: 0 0 12px
      color-mix(in oklab, var(--color-star) 50%, transparent);
    transform-origin: 0 center;
    opacity: 0;
    will-change: transform, opacity;
    animation: shoot var(--duration) linear var(--delay) infinite;
  }

  /* 0-6%: the streak (~1.74s of the 29s cycle). 6-100%: parked and invisible,
     which is what spaces the stars without a scheduler. Motion is linear and
     the fade-out (4.8-6%) happens at full speed, so the star vanishes
     mid-flight instead of stalling. 0.899/0.438 are cos/sin 154deg — the
     components of --travel. */
  @keyframes shoot {
    0% {
      transform: translate3d(0, 0, 0) rotate(154deg);
      opacity: 0;
    }
    0.5% {
      opacity: 1;
    }
    4.8% {
      opacity: 1;
    }
    6%,
    100% {
      transform: translate3d(
          calc(var(--travel) * -0.899),
          calc(var(--travel) * 0.438),
          0
        )
        rotate(154deg);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shooting-stars {
      display: none;
    }
  }
</style>
